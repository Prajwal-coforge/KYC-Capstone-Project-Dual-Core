# Copilot knowledge store (Compose). Copy to `.env` only if you override locally.
# Do not commit real secrets. The mock bank stays on SQLite (`.state/mock.sqlite`).
POSTGRES_USER=kyc
POSTGRES_PASSWORD=kyc
POSTGRES_DB=kyc
# Alpine Postgres has no TLS; disable sslmode here. Cloud SQL/RDS: omit sslmode (defaults to require).
KYC_DATABASE_URL=postgresql://kyc:kyc@postgres:5432/kyc?sslmode=disable
